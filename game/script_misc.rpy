define s = Character("System", color="#ececec")
define n = Character("Narrator")

label gameover1:
    scene bg black default
    n "Unwilling to waste time hanging around with the smallfolk you decide you're better risking the dangers of the forest."

    n "You are wrong."

    n "Barely a half mile from the village, a cold breath brushes against your neck."
    n "The hairs on your arms stand on end as you feel the presence of something watching you."

    n "Kindred does not so easily let go of its prey."

    s "You have died. Game over."

    return